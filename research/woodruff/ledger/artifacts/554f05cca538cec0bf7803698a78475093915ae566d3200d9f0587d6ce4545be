import Mathlib

/-!
Woodruff, "Sketching as a Tool for Numerical Linear Algebra" (arXiv 1411.4357), Definition 12 and
Theorem 13. Header, `JLMoment`, `frob` and the statement are copied from `t13/Statements.lean`.

Proof outline (our own): with `X(u) = ‖Su‖² − ‖u‖²`,
1. homogeneity turns the JL moment bound into `E|X(u)|^ℓ ≤ ‖u‖^{2ℓ} ε^ℓ δ` for every `u`;
2. polarization writes each entry of `AᵀSᵀSB − AᵀB` as `(αβ/4)(X(u₊) − X(u₋))`;
3. convexity of `t ↦ t^ℓ` bounds the two-point difference;
4. finite Jensen with weights `α_i² β_j²` bounds `‖E‖_F^ℓ`;
5. Markov's inequality.
-/

open MeasureTheory ProbabilityTheory

/-- Definition 12: the (ε, δ, ℓ)-JL moment property. -/
def JLMoment {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω) {k d : ℕ}
    (S : Ω → Matrix (Fin k) (Fin d) ℝ) (ε δ ℓ : ℝ) : Prop :=
  ∀ x : Fin d → ℝ, ∑ i, x i ^ 2 = 1 →
    ∫⁻ ω, ENNReal.ofReal (|∑ j, ((S ω).mulVec x j) ^ 2 - 1| ^ ℓ) ∂μ ≤ ENNReal.ofReal (ε ^ ℓ * δ)

/-- Frobenius norm. -/
noncomputable def frob {m p : ℕ} (M : Matrix (Fin m) (Fin p) ℝ) : ℝ :=
  Real.sqrt (∑ a, ∑ b, M a b ^ 2)

namespace T13

/-- `X(u) = ‖M u‖² − ‖u‖²`. -/
noncomputable def qdev {k d : ℕ} (M : Matrix (Fin k) (Fin d) ℝ) (u : Fin d → ℝ) : ℝ :=
  ∑ j, (M.mulVec u j) ^ 2 - ∑ i, u i ^ 2

lemma measurable_mulVec {Ω : Type*} [MeasurableSpace Ω] {k d : ℕ}
    (S : Ω → Matrix (Fin k) (Fin d) ℝ) (hS : ∀ a b, Measurable fun ω => S ω a b)
    (u : Fin d → ℝ) (j : Fin k) : Measurable fun ω => (S ω).mulVec u j := by
  simp only [Matrix.mulVec, dotProduct]
  exact Finset.measurable_sum _ fun l _ => (hS j l).mul_const (u l)

lemma measurable_qdev {Ω : Type*} [MeasurableSpace Ω] {k d : ℕ}
    (S : Ω → Matrix (Fin k) (Fin d) ℝ) (hS : ∀ a b, Measurable fun ω => S ω a b)
    (u : Fin d → ℝ) : Measurable fun ω => qdev (S ω) u := by
  unfold qdev
  exact (Finset.measurable_sum _ fun j _ => (measurable_mulVec S hS u j).pow_const 2).sub
    measurable_const

lemma vec_eq_zero {d : ℕ} (u : Fin d → ℝ) (h : Real.sqrt (∑ l, u l ^ 2) = 0) : u = 0 := by
  rw [Real.sqrt_eq_zero (Finset.sum_nonneg fun l _ => sq_nonneg _),
    Finset.sum_eq_zero_iff_of_nonneg fun l _ => sq_nonneg _] at h
  funext l
  simpa using h l (Finset.mem_univ _)

lemma sqrt_rpow {T : ℝ} (hT : 0 ≤ T) (ℓ : ℝ) : Real.sqrt T ^ ℓ = T ^ (ℓ / 2) := by
  rw [Real.sqrt_eq_rpow, ← Real.rpow_mul hT]
  congr 1
  ring

lemma sq_rpow_half (x ℓ : ℝ) : (x ^ 2) ^ (ℓ / 2) = |x| ^ ℓ := by
  rw [← sq_abs, ← Real.rpow_natCast, ← Real.rpow_mul (abs_nonneg x)]
  congr 1
  push_cast
  ring

/-- Step 1: homogeneity of the JL moment bound. -/
lemma moment_bound {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω) {k d : ℕ}
    (S : Ω → Matrix (Fin k) (Fin d) ℝ) {ε δ ℓ : ℝ} (hJL : JLMoment μ S ε δ ℓ) (hℓ : 0 < ℓ)
    (u : Fin d → ℝ) :
    ∫⁻ ω, ENNReal.ofReal (|qdev (S ω) u| ^ ℓ) ∂μ ≤
      ENNReal.ofReal ((∑ i, u i ^ 2) ^ ℓ * (ε ^ ℓ * δ)) := by
  have hn0 : 0 ≤ ∑ i, u i ^ 2 := Finset.sum_nonneg fun i _ => sq_nonneg _
  rcases hn0.eq_or_lt with h0 | hpos
  · have hu : u = 0 := vec_eq_zero u (by rw [← h0, Real.sqrt_zero])
    subst hu
    simp [qdev, Real.zero_rpow hℓ.ne']
  · have hcc : Real.sqrt (∑ i, u i ^ 2) ^ 2 = ∑ i, u i ^ 2 := Real.sq_sqrt hn0
    have hx : ∑ i, ((Real.sqrt (∑ i, u i ^ 2))⁻¹ • u) i ^ 2 = 1 := by
      simp only [Pi.smul_apply, smul_eq_mul, mul_pow, ← Finset.mul_sum, inv_pow, hcc]
      exact inv_mul_cancel₀ hpos.ne'
    have key : ∀ ω, |qdev (S ω) u| ^ ℓ = (∑ i, u i ^ 2) ^ ℓ *
        |∑ j, ((S ω).mulVec ((Real.sqrt (∑ i, u i ^ 2))⁻¹ • u) j) ^ 2 - 1| ^ ℓ := by
      intro ω
      have h1 : qdev (S ω) u = (∑ i, u i ^ 2) *
          (∑ j, ((S ω).mulVec ((Real.sqrt (∑ i, u i ^ 2))⁻¹ • u) j) ^ 2 - 1) := by
        simp only [qdev, Matrix.mulVec_smul, Pi.smul_apply, smul_eq_mul, mul_pow,
          ← Finset.mul_sum, inv_pow, hcc]
        rw [mul_sub, ← mul_assoc, mul_inv_cancel₀ hpos.ne', one_mul, mul_one]
      rw [h1, abs_mul, abs_of_nonneg hn0, Real.mul_rpow hn0 (abs_nonneg _)]
    calc ∫⁻ ω, ENNReal.ofReal (|qdev (S ω) u| ^ ℓ) ∂μ
        = ∫⁻ ω, ENNReal.ofReal ((∑ i, u i ^ 2) ^ ℓ) * ENNReal.ofReal
            (|∑ j, ((S ω).mulVec ((Real.sqrt (∑ i, u i ^ 2))⁻¹ • u) j) ^ 2 - 1| ^ ℓ) ∂μ := by
          refine lintegral_congr fun ω => ?_
          rw [key, ENNReal.ofReal_mul (Real.rpow_nonneg hn0 _)]
      _ = ENNReal.ofReal ((∑ i, u i ^ 2) ^ ℓ) * ∫⁻ ω, ENNReal.ofReal
            (|∑ j, ((S ω).mulVec ((Real.sqrt (∑ i, u i ^ 2))⁻¹ • u) j) ^ 2 - 1| ^ ℓ) ∂μ :=
          lintegral_const_mul' _ _ ENNReal.ofReal_ne_top
      _ ≤ ENNReal.ofReal ((∑ i, u i ^ 2) ^ ℓ) * ENNReal.ofReal (ε ^ ℓ * δ) := by
          gcongr
          exact hJL _ hx
      _ = _ := (ENNReal.ofReal_mul (Real.rpow_nonneg hn0 _)).symm

/-- Step 2: polarization. -/
lemma polar {k d : ℕ} (M : Matrix (Fin k) (Fin d) ℝ) (a b : Fin d → ℝ) (α β : ℝ) :
    qdev M (α⁻¹ • a + β⁻¹ • b) - qdev M (α⁻¹ • a - β⁻¹ • b) =
      4 / (α * β) * (∑ j, M.mulVec a j * M.mulVec b j - ∑ l, a l * b l) := by
  have h1 : ∑ j, M.mulVec (α⁻¹ • a + β⁻¹ • b) j ^ 2 - ∑ j, M.mulVec (α⁻¹ • a - β⁻¹ • b) j ^ 2
      = 4 / (α * β) * ∑ j, M.mulVec a j * M.mulVec b j := by
    rw [← Finset.sum_sub_distrib, Finset.mul_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    simp only [Matrix.mulVec_add, Matrix.mulVec_sub, Matrix.mulVec_smul, Pi.add_apply,
      Pi.sub_apply, Pi.smul_apply, smul_eq_mul]
    ring
  have h2 : ∑ l, (α⁻¹ • a + β⁻¹ • b) l ^ 2 - ∑ l, (α⁻¹ • a - β⁻¹ • b) l ^ 2
      = 4 / (α * β) * ∑ l, a l * b l := by
    rw [← Finset.sum_sub_distrib, Finset.mul_sum]
    refine Finset.sum_congr rfl fun l _ => ?_
    simp only [Pi.add_apply, Pi.sub_apply, Pi.smul_apply, smul_eq_mul]
    ring
  unfold qdev
  rw [mul_sub, ← h1, ← h2]
  ring

lemma norm_pm {d : ℕ} (a b : Fin d → ℝ) (α β : ℝ) (hα : α ≠ 0) (hβ : β ≠ 0)
    (ha : α ^ 2 = ∑ l, a l ^ 2) (hb : β ^ 2 = ∑ l, b l ^ 2) :
    ∑ l, (α⁻¹ • a + β⁻¹ • b) l ^ 2 + ∑ l, (α⁻¹ • a - β⁻¹ • b) l ^ 2 = 4 := by
  rw [← Finset.sum_add_distrib]
  have h : ∀ l, (α⁻¹ • a + β⁻¹ • b) l ^ 2 + (α⁻¹ • a - β⁻¹ • b) l ^ 2 =
      2 * (α ^ 2)⁻¹ * a l ^ 2 + 2 * (β ^ 2)⁻¹ * b l ^ 2 := by
    intro l
    simp only [Pi.add_apply, Pi.sub_apply, Pi.smul_apply, smul_eq_mul]
    ring
  rw [Finset.sum_congr rfl fun l _ => h l, Finset.sum_add_distrib, ← Finset.mul_sum,
    ← Finset.mul_sum, ← ha, ← hb, mul_assoc, mul_assoc,
    inv_mul_cancel₀ (pow_ne_zero 2 hα), inv_mul_cancel₀ (pow_ne_zero 2 hβ)]
  norm_num

lemma real_add_rpow_le {x y p : ℝ} (hx : 0 ≤ x) (hy : 0 ≤ y) (hp : 1 ≤ p) :
    (x + y) ^ p ≤ 2 ^ (p - 1) * (x ^ p + y ^ p) := by
  lift x to NNReal using hx
  lift y to NNReal using hy
  exact_mod_cast NNReal.rpow_add_le_mul_rpow_add_rpow x y hp

/-- Step 3: the two-point convexity bound. -/
lemma two_point (s t ℓ : ℝ) (hℓ : 1 ≤ ℓ) :
    |(s - t) / 4| ^ ℓ ≤ 2 ^ (ℓ - 1) / 4 ^ ℓ * (|s| ^ ℓ + |t| ^ ℓ) := by
  have h0 : 0 ≤ ℓ := by linarith
  rw [abs_div, abs_of_pos (by norm_num : (0 : ℝ) < 4),
    Real.div_rpow (abs_nonneg _) (by norm_num), div_mul_eq_mul_div]
  gcongr
  have hst : |s - t| ≤ |s| + |t| := by
    have := abs_add_le s (-t)
    rwa [abs_neg, ← sub_eq_add_neg] at this
  calc |s - t| ^ ℓ ≤ (|s| + |t|) ^ ℓ := Real.rpow_le_rpow (abs_nonneg _) hst h0
    _ ≤ _ := real_add_rpow_le (abs_nonneg _) (abs_nonneg _) hℓ

/-- Step 4: finite Jensen with nonnegative (unnormalized) weights. -/
lemma jensen {ι : Type*} [Fintype ι] (w t : ι → ℝ) (hw : ∀ i, 0 ≤ w i) (ht : ∀ i, 0 ≤ t i)
    {q : ℝ} (hq : 1 ≤ q) :
    (∑ i, w i * t i) ^ q ≤ (∑ i, w i) ^ (q - 1) * ∑ i, w i * t i ^ q := by
  have hW0 : 0 ≤ ∑ i, w i := Finset.sum_nonneg fun i _ => hw i
  rcases hW0.eq_or_lt with h0 | hpos
  · have hw0 : ∀ i, w i = 0 := fun i =>
      (Finset.sum_eq_zero_iff_of_nonneg fun i _ => hw i).1 h0.symm i (Finset.mem_univ _)
    simp [hw0, Real.zero_rpow (by linarith : q ≠ 0)]
  · have hne : (∑ i, w i) ≠ 0 := hpos.ne'
    have key := Real.rpow_arith_mean_le_arith_mean_rpow Finset.univ
      (fun i => w i / ∑ j, w j) t (fun i _ => div_nonneg (hw i) hW0)
      (by rw [← Finset.sum_div, div_self hne]) (fun i _ => ht i) hq
    have e1 : ∑ i, w i * t i = (∑ j, w j) * ∑ i, w i / (∑ j, w j) * t i := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      field_simp
    have e2 : ∑ i, w i * t i ^ q = (∑ j, w j) * ∑ i, w i / (∑ j, w j) * t i ^ q := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      field_simp
    rw [e1, e2, Real.mul_rpow hW0
      (Finset.sum_nonneg fun i _ => mul_nonneg (div_nonneg (hw i) hW0) (ht i)),
      Real.rpow_sub_one hne]
    calc (∑ j, w j) ^ q * (∑ i, w i / (∑ j, w j) * t i) ^ q
        ≤ (∑ j, w j) ^ q * ∑ i, w i / (∑ j, w j) * t i ^ q :=
          mul_le_mul_of_nonneg_left key (Real.rpow_nonneg hW0 _)
      _ = (∑ j, w j) ^ q / (∑ j, w j) * ((∑ j, w j) * ∑ i, w i / (∑ j, w j) * t i ^ q) := by
          field_simp

lemma wt_eq (c e : ℝ) (h : c = 0 → e = 0) : c ^ 2 * (e / c) ^ 2 = e ^ 2 := by
  by_cases hc : c = 0
  · simp [hc, h hc]
  · field_simp

lemma entry_eq {k d m p : ℕ} (M : Matrix (Fin k) (Fin d) ℝ) (A : Matrix (Fin d) (Fin m) ℝ)
    (B : Matrix (Fin d) (Fin p) ℝ) (i : Fin m) (j : Fin p) :
    (A.transpose * M.transpose * M * B - A.transpose * B) i j =
      ∑ x, M.mulVec (A.transpose i) x * M.mulVec (B.transpose j) x - ∑ l, A.transpose i l * B.transpose j l := by
  have hm : A.transpose * M.transpose * M * B = (M * A).transpose * (M * B) := by
    simp only [Matrix.transpose_mul, Matrix.mul_assoc]
  rw [hm]
  simp only [Matrix.sub_apply, Matrix.mul_apply, Matrix.transpose_apply, Matrix.mulVec,
    dotProduct]

lemma entry_zero {k d : ℕ} (M : Matrix (Fin k) (Fin d) ℝ) (a b : Fin d → ℝ)
    (h : a = 0 ∨ b = 0) : ∑ x, M.mulVec a x * M.mulVec b x - ∑ l, a l * b l = 0 := by
  rcases h with rfl | rfl <;> simp

/-- Steps 2 and 3 combined, for one entry. -/
lemma term_bound {k d : ℕ} (M : Matrix (Fin k) (Fin d) ℝ) (a b : Fin d → ℝ) (α β : ℝ)
    {ℓ : ℝ} (hℓ : 1 ≤ ℓ) :
    (((∑ x, M.mulVec a x * M.mulVec b x - ∑ l, a l * b l) / (α * β)) ^ 2) ^ (ℓ / 2) ≤
      2 ^ (ℓ - 1) / 4 ^ ℓ *
        (|qdev M (α⁻¹ • a + β⁻¹ • b)| ^ ℓ + |qdev M (α⁻¹ • a - β⁻¹ • b)| ^ ℓ) := by
  rw [sq_rpow_half]
  have he : (∑ x, M.mulVec a x * M.mulVec b x - ∑ l, a l * b l) / (α * β) =
      (qdev M (α⁻¹ • a + β⁻¹ • b) - qdev M (α⁻¹ • a - β⁻¹ • b)) / 4 := by
    rw [polar M a b α β]
    ring
  rw [he]
  exact two_point _ _ _ hℓ

lemma pair_bound {d : ℕ} (a b : Fin d → ℝ) (α β : ℝ) (ha : α ^ 2 = ∑ l, a l ^ 2)
    (hb : β ^ 2 = ∑ l, b l ^ 2) {ℓ : ℝ} (hℓ : 1 ≤ ℓ) :
    (α * β) ^ 2 * ((∑ l, (α⁻¹ • a + β⁻¹ • b) l ^ 2) ^ ℓ +
      (∑ l, (α⁻¹ • a - β⁻¹ • b) l ^ 2) ^ ℓ) ≤ (α * β) ^ 2 * 4 ^ ℓ := by
  by_cases h : α * β = 0
  · rw [h]
    simp
  · apply mul_le_mul_of_nonneg_left _ (sq_nonneg _)
    rw [← norm_pm a b α β (left_ne_zero_of_mul h) (right_ne_zero_of_mul h) ha hb]
    exact Real.add_rpow_le_rpow_add (Finset.sum_nonneg fun _ _ => sq_nonneg _)
      (Finset.sum_nonneg fun _ _ => sq_nonneg _) hℓ

/-- Integrating a nonnegative combination of moment bounds. -/
lemma lintegral_sum_bound {Ω ι : Type*} [MeasurableSpace Ω] [Fintype ι] (μ : Measure Ω)
    (c : ι → ℝ) (F G : ι → Ω → ℝ) (bF bG : ι → ℝ) (hc : ∀ x, 0 ≤ c x)
    (hF0 : ∀ x ω, 0 ≤ F x ω) (hG0 : ∀ x ω, 0 ≤ G x ω)
    (hFm : ∀ x, Measurable (F x)) (hGm : ∀ x, Measurable (G x))
    (hF : ∀ x, ∫⁻ ω, ENNReal.ofReal (F x ω) ∂μ ≤ ENNReal.ofReal (bF x))
    (hG : ∀ x, ∫⁻ ω, ENNReal.ofReal (G x ω) ∂μ ≤ ENNReal.ofReal (bG x))
    (hbF : ∀ x, 0 ≤ bF x) (hbG : ∀ x, 0 ≤ bG x) :
    ∫⁻ ω, ENNReal.ofReal (∑ x, c x * (F x ω + G x ω)) ∂μ ≤
      ENNReal.ofReal (∑ x, c x * (bF x + bG x)) := by
  have mF : ∀ x, Measurable fun ω => ENNReal.ofReal (c x) * ENNReal.ofReal (F x ω) :=
    fun x => (ENNReal.measurable_ofReal.comp (hFm x)).const_mul _
  have mG : ∀ x, Measurable fun ω => ENNReal.ofReal (c x) * ENNReal.ofReal (G x ω) :=
    fun x => (ENNReal.measurable_ofReal.comp (hGm x)).const_mul _
  calc ∫⁻ ω, ENNReal.ofReal (∑ x, c x * (F x ω + G x ω)) ∂μ
      = ∫⁻ ω, ∑ x, (ENNReal.ofReal (c x) * ENNReal.ofReal (F x ω) +
          ENNReal.ofReal (c x) * ENNReal.ofReal (G x ω)) ∂μ := by
        refine lintegral_congr fun ω => ?_
        rw [ENNReal.ofReal_sum_of_nonneg fun x _ =>
          mul_nonneg (hc x) (add_nonneg (hF0 x ω) (hG0 x ω))]
        refine Finset.sum_congr rfl fun x _ => ?_
        rw [ENNReal.ofReal_mul (hc x), ENNReal.ofReal_add (hF0 x ω) (hG0 x ω), mul_add]
    _ = ∑ x, (ENNReal.ofReal (c x) * ∫⁻ ω, ENNReal.ofReal (F x ω) ∂μ +
          ENNReal.ofReal (c x) * ∫⁻ ω, ENNReal.ofReal (G x ω) ∂μ) := by
        rw [lintegral_finsetSum (f := fun x ω => ENNReal.ofReal (c x) * ENNReal.ofReal (F x ω) +
          ENNReal.ofReal (c x) * ENNReal.ofReal (G x ω)) _ fun x _ => (mF x).add (mG x)]
        refine Finset.sum_congr rfl fun x _ => ?_
        rw [lintegral_add_left (mF x), lintegral_const_mul' _ _ ENNReal.ofReal_ne_top,
          lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    _ ≤ ∑ x, (ENNReal.ofReal (c x) * ENNReal.ofReal (bF x) +
          ENNReal.ofReal (c x) * ENNReal.ofReal (bG x)) := by
        gcongr with x
        · exact hF x
        · exact hG x
    _ = _ := by
        rw [ENNReal.ofReal_sum_of_nonneg fun x _ =>
          mul_nonneg (hc x) (add_nonneg (hbF x) (hbG x))]
        refine Finset.sum_congr rfl fun x _ => ?_
        rw [ENNReal.ofReal_mul (hc x), ENNReal.ofReal_add (hbF x) (hbG x), mul_add]

end T13

open T13 in
/-- Theorem 13. -/
theorem woodruff_theorem13 {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω) [IsProbabilityMeasure μ]
    {k d m p : ℕ} (S : Ω → Matrix (Fin k) (Fin d) ℝ) (hS : ∀ a b, Measurable fun ω => S ω a b)
    (ε δ ℓ : ℝ) (hε : 0 < ε) (hε2 : ε < 1 / 2) (hδ : 0 < δ) (hδ2 : δ < 1 / 2) (hℓ : 2 ≤ ℓ)
    (hJL : JLMoment μ S ε δ ℓ)
    (A : Matrix (Fin d) (Fin m) ℝ) (B : Matrix (Fin d) (Fin p) ℝ) :
    μ {ω | 3 * ε * frob A * frob B <
      frob (A.transpose * (S ω).transpose * S ω * B - A.transpose * B)} ≤ ENNReal.ofReal δ := by
  classical
  have hℓ1 : 1 ≤ ℓ := by linarith
  have hℓ0 : 0 < ℓ := by linarith
  have hq : 1 ≤ ℓ / 2 := by linarith
  -- column norms
  obtain ⟨α, hα⟩ : ∃ α : Fin m → ℝ, ∀ i, α i = Real.sqrt (∑ l, A.transpose i l ^ 2) :=
    ⟨_, fun _ => rfl⟩
  obtain ⟨β, hβ⟩ : ∃ β : Fin p → ℝ, ∀ j, β j = Real.sqrt (∑ l, B.transpose j l ^ 2) :=
    ⟨_, fun _ => rfl⟩
  have hα0 : ∀ i, α i = 0 → A.transpose i = 0 := fun i h => vec_eq_zero _ (by rw [← hα i]; exact h)
  have hβ0 : ∀ j, β j = 0 → B.transpose j = 0 := fun j h => vec_eq_zero _ (by rw [← hβ j]; exact h)
  have hα2 : ∀ i, α i ^ 2 = ∑ l, A.transpose i l ^ 2 := fun i => by
    rw [hα i, Real.sq_sqrt (Finset.sum_nonneg fun _ _ => sq_nonneg _)]
  have hβ2 : ∀ j, β j ^ 2 = ∑ l, B.transpose j l ^ 2 := fun j => by
    rw [hβ j, Real.sq_sqrt (Finset.sum_nonneg fun _ _ => sq_nonneg _)]
  -- entries of the error matrix
  obtain ⟨E, hE⟩ : ∃ E : Ω → Fin m → Fin p → ℝ, ∀ ω i j, E ω i j =
      ∑ x, (S ω).mulVec (A.transpose i) x * (S ω).mulVec (B.transpose j) x - ∑ l, A.transpose i l * B.transpose j l :=
    ⟨_, fun _ _ _ => rfl⟩
  have hfrobE : ∀ ω, frob (A.transpose * (S ω).transpose * S ω * B - A.transpose * B)
      = Real.sqrt (∑ i, ∑ j, E ω i j ^ 2) := by
    intro ω
    unfold frob
    simp only [entry_eq, hE]
  simp_rw [hfrobE]
  have hEzero : ∀ ω i j, α i * β j = 0 → E ω i j = 0 := by
    intro ω i j h
    rw [hE]
    apply entry_zero
    rcases mul_eq_zero.1 h with h | h
    · exact Or.inl (hα0 i h)
    · exact Or.inr (hβ0 j h)
  have hEm : ∀ i j, Measurable fun ω => E ω i j := by
    intro i j
    simp only [hE]
    exact (Finset.measurable_sum _ fun x _ =>
      (measurable_mulVec S hS _ x).mul (measurable_mulVec S hS _ x)).sub measurable_const
  obtain ⟨W, hW⟩ : ∃ W : ℝ, W = ∑ x : Fin m × Fin p, (α x.1 * β x.2) ^ 2 := ⟨_, rfl⟩
  have hW0 : 0 ≤ W := by
    rw [hW]
    exact Finset.sum_nonneg fun _ _ => sq_nonneg _
  have hFA : 0 ≤ frob A := Real.sqrt_nonneg _
  have hFB : 0 ≤ frob B := Real.sqrt_nonneg _
  rcases hW0.eq_or_lt with hW00 | hWpos
  · -- degenerate case: every entry of the error vanishes
    have hab : ∀ i j, α i * β j = 0 := by
      intro i j
      have hsum : ∑ x : Fin m × Fin p, (α x.1 * β x.2) ^ 2 = 0 := by
        rw [← hW]
        exact hW00.symm
